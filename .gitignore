# This is an example .gitignore file
# Copy this to .gitignore and modify as needed

# Backend specific
backend/node_modules/
backend/.env
backend/uploads/
backend/logs/

# Frontend specific
frontend/node_modules/
frontend/.env
frontend/dist/
frontend/build/

# Root level
.env
.env.local
.DS_Store
node_modules/
dist/
build/
coverage/

# Keep these directories (they will be created with .gitkeep files)
!backend/uploads/.gitkeep
!backend/logs/.gitkeep
!frontend/public/uploads/.gitkeep